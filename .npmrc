# pnpm 10.x cannot launch a pinned pnpm 11.x on Windows: it fetches the
# @pnpm/win-x64 artifact, whose exe requires a dist/pnpm.mjs the package does
# not ship, then looks for a bin/ the 11.x layout no longer has. The result is
# "Failed to switch pnpm to v11.3.0" on every command.
#
# Turning the switch off makes every script run under whichever pnpm the
# developer has installed. packageManager in package.json still records the
# version this project is developed against, and pnpm-lock.yaml still pins
# every dependency, so builds stay reproducible.
manage-package-manager-versions=false
